<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Tab Magazzino: gli spezzoni riusabili ("pezzi") e le operazioni su di essi. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cutcalculator.gui.SchermataMagazzino">
    <center>
        <TableView fx:id="tabella">
            <columns>
                <TableColumn fx:id="colonnaProfilo" text="Profilo" prefWidth="300.0"/>
                <TableColumn fx:id="colonnaColore" text="Colore" prefWidth="140.0"/>
                <TableColumn fx:id="colonnaLunghezza" text="Lunghezza (mm)" prefWidth="140.0"/>
                <TableColumn fx:id="colonnaQuantita" text="Quantita'" prefWidth="90.0"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="8.0">
            <padding>
                <Insets top="10.0" right="12.0" bottom="12.0" left="12.0"/>
            </padding>
            <children>
                <HBox spacing="10.0">
                    <children>
                        <Label fx:id="riepilogo" text="Nessun pezzo a magazzino."/>
                    </children>
                </HBox>
                <GridPane hgap="8.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="70.0"/>
                        <ColumnConstraints minWidth="240.0"/>
                        <ColumnConstraints minWidth="70.0"/>
                        <ColumnConstraints minWidth="160.0"/>
                    </columnConstraints>
                    <children>
                        <Label text="Sistema" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="sceltaSistema" prefWidth="240.0"
                                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Profilo" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <ComboBox fx:id="sceltaProfilo" prefWidth="320.0"
                                  GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                        <Label text="Colore" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="campoColore" promptText="bianco, bronzo, RAL9010..."
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Lunghezza" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <HBox spacing="8.0" GridPane.rowIndex="1" GridPane.columnIndex="3">
                            <children>
                                <TextField fx:id="campoLunghezza" prefWidth="120.0" promptText="mm"/>
                                <Label text="Quantita'"/>
                                <Spinner fx:id="campoQuantita" prefWidth="90.0"/>
                            </children>
                        </HBox>
                    </children>
                </GridPane>
                <HBox spacing="10.0">
                    <children>
                        <Button text="Aggiungi pezzo" onAction="#aggiungi" defaultButton="true"/>
                        <Button text="Rimuovi selezionato" onAction="#rimuovi"/>
                        <Button text="Svuota magazzino" onAction="#svuota"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>
</BorderPane>
